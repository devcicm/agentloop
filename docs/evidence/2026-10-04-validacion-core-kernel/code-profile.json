    {
      "id": "verify",
      "arguments": [],
      "modelCallable": false,
      "timeoutSeconds": 120
    }
  ],
  "execution": {
    "adapter": "docker",
    "docker": {
      "executable": "C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe",
